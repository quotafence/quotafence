{
  "name": "quotafence",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run check:release-version && npm run check:npm-cli && npm run build && npm run check:rust",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:npm-cli": "node scripts/check-npm-cli.mjs",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --locked --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "quotafence": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin quotafence --",
    "qfence": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin quotafence --",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
